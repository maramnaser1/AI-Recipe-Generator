# =========================
def generate_recipe():
    """Handles recipe generation using Gemini API."""
    
    ingredients = ingredients_entry.get().strip()
    meal_type = meal_type_var.get()

    # Validate user input
    if not ingredients:
        messagebox.showwarning("Warning", "⚠️ You must enter at least one ingredient.")
        return

    # Build the text prompt for the LLM
    prompt_text = f"""
Please create a {meal_type} recipe using the following ingredients: {ingredients}.
Include:
- A creative name starting with 'Recipe Title:'
- A short introduction
- Ingredients list labeled 'Ingredients:'
- Step-by-step instructions labeled 'Cooking Steps:'
Make the recipe coherent, easy to follow, and suitable for home cooking.
"""

    headers = {
        "Content-Type": "application/json",
        "x-goog-api-key": API_KEY
    }

    data = {
        "model": "gemini-2.5-flash",
        "contents": [
            {
                "parts": [
                    {"text": prompt_text}
                ]
            }
        ]
    }

    # Clear previous output and show loading message
    output_box.delete("1.0", tk.END)
    output_box.insert(tk.END, "🔄 Generating recipe... please wait.\n")

    try:
        # Send POST request to Gemini API
        response = requests.post(API_URL, headers=headers, json=data)

        # Handle successful response
        if response.status_code == 200:
            result = response.json()
            try:
                # Extract recipe text from response
                recipe = result["candidates"][0]["content"]["parts"][0]["text"]
            except (KeyError, IndexError):
                recipe = json.dumps(result, indent=2)

            # Display the formatted recipe
            output_box.delete("1.0", tk.END)
            output_box.insert(tk.END, "============================\n")
            output_box.insert(tk.END, "🍽️  Generated Recipe\n")
            output_box.insert(tk.END, "============================\n")
            output_box.insert(tk.END, recipe.strip() + "\n")
            output_box.insert(tk.END, "============================\n✅ Recipe generation complete.\n")

        # Handle unsuccessful response
        else:
            output_box.delete("1.0", tk.END)
            output_box.insert(tk.END, f"❌ Error: {response.status_code}\n{response.text}")

    except Exception as e:
        # Handle unexpected errors
        messagebox.showerror("Error", str(e))

